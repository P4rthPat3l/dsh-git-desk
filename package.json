{
  "name": "dsh-git-desk",
  "version": "0.22.0",
  "type": "module",
  "description": "Git desk for DeepSeek Harness: a right-sidebar Git workbench with full-file side-by-side diffs, block staging, commits, history, branches, stash, and sync.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "git",
    "diff",
    "source-control",
    "staging",
    "commit",
    "stash"
  ],
  "license": "MIT",
  "author": "Parth Patel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P4rthPat3l/dsh-git-desk.git"
  },
  "homepage": "https://github.com/P4rthPat3l/dsh-git-desk#readme",
  "bugs": {
    "url": "https://github.com/P4rthPat3l/dsh-git-desk/issues"
  },
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p src/host/tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p src/host/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
